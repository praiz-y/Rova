PORT=3001
FRONTEND_ORIGIN=http://localhost:5176
DATABASE_URL=postgres://nimiq_quiz:nimiq_quiz@localhost:5434/nimiq_quiz
SESSION_JWT_SECRET=replace-with-a-long-random-value

# D042: the shared project deposit address sponsors fund contests into.
# Generate with `npx tsx src/auth/generate-deposit-wallet.ts` for dev/test —
# see .secrets/deposit-wallet.txt (gitignored) for the matching private key.
# Funding endpoints return 503 until this is set.
NIMIQ_DEPOSIT_ADDRESS=

# D042/D048: private key for the shared payout wallet. Payout/settlement
# transactions are signed LOCALLY (see blockchain/nimiqLocalSigner.ts) and
# broadcast via sendRawTransaction — this does NOT require the configured
# RPC node to support wallet/keystore methods (importRawKey/unlockAccount/
# sendTransaction), which most public RPCs reject anyway. The key never
# leaves this process.
NIMIQ_PAYOUT_PRIVATE_KEY=
NIMIQ_PAYOUT_FINALITY_ATTEMPTS=12
NIMIQ_PAYOUT_FINALITY_POLL_MS=5000
NIMIQ_RPC_TIMEOUT_MS=15000
NIMIQ_RPC_TRANSACTION_LOOKUP_LIMIT=30

# D048: numeric Nimiq network ID transactions are signed for. Verified
# directly against core-rs-albatross primitives/src/networks.rs:
#   5 = TestAlbatross (testnet, the default below)
#   24 = MainAlbatross (mainnet)
# Must match the network NIMIQ_RPC_URL actually points to, or signed
# transactions will be rejected as invalid for that chain.
NIMIQ_NETWORK_ID=5

# Defaults to a free third-party public RPC if unset — see nimiqRpc.ts's
# module docstring for the trust caveat. Override for anything beyond MVP.
# Public testnet RPC for Phase 3. Supports reads and sendRawTransaction;
# rate-limits (HTTP 429) under heavy back-to-back use — payout/settlement
# processing already retries safely (idempotent) if this is hit.
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
