# Leave empty when frontend and backend share an origin in deployment.
# For a separately hosted backend, set its public HTTPS origin.
VITE_API_BASE_URL=

# The current Phase 3/4 test environment uses Nimiq testnet.
# Switch this to https://nimiqwatch.com before a mainnet launch.
VITE_NIMIQ_EXPLORER_BASE_URL=https://test.nimiq.watch

# Desktop wallet fallback (D050): the Nimiq Hub API endpoint used when this
# Mini App is opened outside Nimiq Pay (e.g. a normal desktop browser).
# Switch this to https://hub.nimiq.com before a mainnet launch.
VITE_NIMIQ_HUB_URL=https://hub.nimiq-testnet.com
